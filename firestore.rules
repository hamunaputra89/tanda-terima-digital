rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHandoverRecord(data) {
      return data.handoverNumber is string && data.handoverNumber.size() <= 100
        && data.date is string && data.date.size() <= 20
        && data.expedition is string && data.expedition.size() <= 100
        && data.courierName is string && data.courierName.size() <= 150
        && data.warehouseName is string && data.warehouseName.size() <= 150
        && data.receiverName is string && data.receiverName.size() <= 150
        && data.totalQuantity is number && data.totalQuantity >= 0
        && data.status is string && data.status.size() <= 50;
    }

    function isValidWarehouseProfile(data) {
      return data.warehouseName is string && data.warehouseName.size() <= 150;
    }

    // Handover receipts collection
    match /handover_records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(recordId) && isValidHandoverRecord(request.resource.data);
      allow update: if isSignedIn() && isValidId(recordId) && isValidHandoverRecord(request.resource.data);
      allow delete: if isSignedIn() && isValidId(recordId);
    }

    // Warehouse identity profile collection
    match /warehouse_profiles/{profileId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(profileId) && isValidWarehouseProfile(request.resource.data);
      allow delete: if isSignedIn() && isValidId(profileId);
    }
  }
}
